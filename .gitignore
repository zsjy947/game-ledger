# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# 抓取脚本缓存（港服中文数据镜像等）
scripts/.cache/

# 打包输出（release\GameLedger\ 为便携成品；build\ 为 PyInstaller 中间产物）
build/
release/
.android-build/

# 安卓构建：APK 产物与 www 构建生成物（prepare_assets.py 重建）
android/output/
android/app/src/main/assets/www/
android/app/src/main/res/mipmap-*/

# 安卓发布签名密钥（丢失无法覆盖升级，绝不能提交或删除）
keystore/

# 旧方案遗留的调试签名（重建后不应再出现）
android/debug.keystore

# 迁移备份库与运行时封面缓存（正式数据库 data/prices.db 保留与否由使用者决定）
data/prices.backup-*.db
data/covers/

# 本地计划/报告文档（不入库）
docs/
